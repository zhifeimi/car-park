{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'deps resolve through deno.json at build time'",
  "buildCommand": "npx -y deno@2 task build",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/$",
      "status": 307,
      "headers": {
        "Location": "/mobile/"
      }
    },
    {
      "src": "^/prod-api/(.*)$",
      "dest": "https://api.carpark.zhifei.org/$1",
      "transforms": [
        {
          "type": "request.headers",
          "op": "set",
          "target": {
            "key": "x-proxy-secret"
          },
          "args": "$RATE_LIMIT_PROXY_SECRET",
          "env": [
            "RATE_LIMIT_PROXY_SECRET"
          ]
        }
      ]
    },
    {
      "src": "^/mobile/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/mobile/(.+)$",
      "dest": "/$1"
    }
  ]
}
