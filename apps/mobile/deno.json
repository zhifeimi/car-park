{
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview"
  },
  "imports": {
    "@car-park/utils": "../../packages/utils/src/index.ts",
    "@car-park/ui": "../../packages/ui/src/index.ts",

    "vue": "./src/vendor/vue.js",
    "vue-runtime": "npm:vue@3.5.41/dist/vue.runtime.esm-bundler.js",
    "vue-router": "npm:vue-router@^4.5.0/dist/vue-router.mjs",
    "axios": "npm:axios@^1.19.0",
    "vant": "npm:vant@^4.10.0/es/index.mjs",
    "vant/es/locale/lang/en-US": "npm:vant@^4.10.0/es/locale/lang/en-US.mjs",
    "vant/es/locale/lang/zh-CN": "npm:vant@^4.10.0/es/locale/lang/zh-CN.mjs",
    "qrcode": "./src/vendor/qrcode.js",
    "vite": "npm:vite@^8.2.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@2.0.2",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@^6.0.0",

    "@vue/runtime-dom": "npm:@vue/runtime-dom@3.5.41/dist/runtime-dom.esm-bundler.js",
    "@vue/runtime-core": "npm:@vue/runtime-core@3.5.41/dist/runtime-core.esm-bundler.js",
    "@vue/reactivity": "npm:@vue/reactivity@3.5.41/dist/reactivity.esm-bundler.js",
    "@vue/shared": "npm:@vue/shared@3.5.41/dist/shared.esm-bundler.js",

    "@vant/popperjs": "npm:@vant/popperjs@^1.3.0",
    "@vant/use": "npm:@vant/use@^1.6.0",
    "@popperjs/core": "npm:@popperjs/core@^2.11.7"
  },
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "fmt": {
    "exclude": ["dist", "src/vendor"]
  },
  "lint": {
    "exclude": ["dist", "src/vendor"]
  }
}
