# CarPark / 停车场预约管理系统 environment template
# Copy this file to .env and replace the changeme values.
# Do not commit your populated .env file.

# === Backend required configuration ===
DB_URL=jdbc:mysql://localhost:3306/carpark?useUnicode=true&characterEncoding=utf8&serverTimezone=Australia/Sydney&useSSL=true&allowPublicKeyRetrieval=true
DB_USERNAME=carpark
DB_PASSWORD=changeme-local-db-password
JWT_SECRET=changeme-generate-a-random-secret-at-least-32-bytes
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# The park's clock: "today" for bookings/availability, audit timestamps, JSON dates.
# Unset → Australia/Sydney (application.yml). Keep serverTimezone in the JDBC URLs equal to it.
TZ=Australia/Sydney

# === Docker Compose development database ===
MYSQL_ROOT_PASSWORD=root_dev_only  # optional: compose defaults to this for local dev
MYSQL_PASSWORD=carpark_dev  # optional: compose defaults to this; must match application-dev.yml

# === Optional dev-profile datasource overrides ===
# application-dev.yml has localhost defaults. Set these when using a remote or alternate dev DB.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/carpark?useUnicode=true&characterEncoding=utf8&serverTimezone=Australia/Sydney&useSSL=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=carpark
SPRING_DATASOURCE_PASSWORD=changeme-local-db-password

# === Optional test profile ===
# Used by database-tagged integration tests when a separate test JWT is desired.
TEST_JWT_SECRET=changeme-generate-a-test-secret-at-least-32-bytes

# === Optional remote development tunnel ===
CARPARK_DB_HOST=dev-db.example.com

# === Optional backend logging ===
# Log directory for the file appender; defaults to ./logs if unset.
# LOG_PATH=./logs

# === Optional frontend API base (set in apps/web/.env.* or apps/mobile/.env.*) ===
# Both apps have built-in defaults; only override when the proxy prefix differs.
# VITE_APP_BASE_API=/prod-api
